{
  "name": "warriorforge-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:backend dev:frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm-run-all build:backend build:frontend",
    "build:backend": "npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "start:backend": "npm run start --workspace backend",
    "preview:frontend": "npm run preview --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "test": "npm run test --if-present",
    "db:generate": "npm run prisma:generate --workspace backend",
    "db:migrate": "npm run prisma:migrate --workspace backend",
    "db:seed": "npm run prisma:seed --workspace backend",
    "clean": "npm run clean:all",
    "clean:all": "rimraf node_modules backend/node_modules frontend/node_modules shared/node_modules backend/dist frontend/dist",
    "setup": "npm install && npm run db:generate",
    "pre-commit": "bash scripts/pre-commit.sh",
    "build:prod": "bash scripts/build.sh || pwsh scripts/build.ps1",
    "deploy": "bash scripts/deploy.sh || pwsh scripts/deploy.ps1",
    "test:full": "bash scripts/test.sh || pwsh scripts/test.ps1"
  },
  "postinstall": "npm run db:generate",
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.5"
  }
}
