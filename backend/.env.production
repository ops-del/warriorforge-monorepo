# Railway Environment Variables Template
# Copy these to Railway dashboard: https://railway.app/dashboard

# Database - Add PostgreSQL plugin in Railway, then copy connection string
DATABASE_URL=postgresql://user:password@host:port/database

# Application
NODE_ENV=production
PORT=5000

# CORS - Update with your Vercel domain after frontend deployment
CORS_ORIGIN=https://warriorforgeai.vercel.app

# Admin Authentication
ADMIN_EMAIL=ops@warriorforgeai.com
ADMIN_JWT_SECRET=WzBWxTmyEVPCn1WpJD3bwReQXePfEzAKl41+6IYH/Ww=
ADMIN_PASSWORD_HASH=$2a$10$36zsI0oywqIKz/dlVLkgn.0Xl1RsbVVL5gNht4iIOTm0wpsploow.

# SMTP Configuration - Option 1: Resend (Recommended)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_get_from_resend_dashboard
SMTP_SECURE=false

# SMTP Configuration - Option 2: Gmail (Alternative)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_SECURE=false

# Instructions:
# 1. Add PostgreSQL database in Railway dashboard
# 2. Copy DATABASE_URL from Railway PostgreSQL plugin
# 3. Update CORS_ORIGIN after deploying frontend to Vercel
# 4. Sign up at https://resend.com and get API key for SMTP_PASS
# 5. Add all these variables in Railway project settings
